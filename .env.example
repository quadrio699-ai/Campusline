# Copy this file to .env.local and fill in your own Supabase project's values.
# Settings -> API -> "Publishable and secret API keys" tab in your Supabase dashboard.
# Only the publishable/anon key goes here — never the secret key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Email alerts (Resend) — from resend.com, free, no domain needed to start.
# NOTIFY_EMAIL must match the email you signed up to Resend with, until
# you verify your own sending domain.
RESEND_API_KEY=your-resend-api-key

# Per-campus routing: each concern is emailed to that campus's welfare
# officer. Set the ones you have officers for now — any campus without
# its own address here falls back to NOTIFY_EMAIL below, so nothing is
# lost while the others get onboarded.
NOTIFY_EMAIL_OJO=ojo-welfare-officer@example.com
NOTIFY_EMAIL_IKEJA=ikeja-welfare-officer@example.com
NOTIFY_EMAIL_EPE=epe-welfare-officer@example.com

# Fallback recipient — used for any campus above that isn't set yet,
# and as your own copy if you want one.
NOTIFY_EMAIL=Quadrio699@gmail.com
